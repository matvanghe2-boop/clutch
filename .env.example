# Contact inscrit dans le User-Agent envoyé à Liquipedia (exigé par leurs conditions d'utilisation).
# Une adresse e-mail ou une URL où l'on peut te joindre. Par défaut : ton profil GitHub.
LIQUIPEDIA_CONTACT=

# Code demandé par la page Réglages avant de modifier les équipes suivies.
# À définir aussi dans Vercel (Settings → Environment Variables). Sans lui, les équipes sont en lecture seule.
CLUTCH_ADMIN_PIN=

# Facultatif : si défini, /api/sync n'accepte que les appels du cron Vercel (en-tête Authorization: Bearer …).
CRON_SECRET=

# Base de données (Redis, Upstash) : écrites par « npx vercel integration add upstash/upstash-kv ».
# En local, elles sont ignorées : le site lit data/. CLUTCH_USE_DB=1 force l'accès à la base de production.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
